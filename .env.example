# Copy to .env and fill in. .env is gitignored; this file is the only one committed.
# Locally, config/settings/dev.py loads .env. On the server the same variables
# live in /etc/cme/env (mode 600), loaded by systemd's EnvironmentFile.

# Server only. Locally manage.py already defaults to config.settings.dev, and
# setting it in .env has no effect.
# DJANGO_SETTINGS_MODULE=config.settings.prod

# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me

# Server only. Comma-separated hostnames.
# DJANGO_ALLOWED_HOSTS=rounds.example.org

# Postgres
DATABASE_NAME=cme_dev
DATABASE_USER=cme_app
DATABASE_PASSWORD=change-me
DATABASE_HOST=localhost
DATABASE_PORT=5432

# Server only: Amazon SES over SMTP. Dev prints emails to the terminal.
# EMAIL_HOST=email-smtp.ca-central-1.amazonaws.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=change-me
# EMAIL_HOST_PASSWORD=change-me
# DEFAULT_FROM_EMAIL=rounds@example.org

# Where raw Teams exports and issued PDFs are stored (outside the repo on the server)
UPLOAD_ROOT=./uploads
