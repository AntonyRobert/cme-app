# Copy to .env and fill in. .env is gitignored; this file is the only one committed.
# On the server these live in /etc/cme/env (mode 600), loaded by systemd EnvironmentFile.

# Which settings module to load: config.settings.dev or config.settings.prod
DJANGO_SETTINGS_MODULE=config.settings.dev

# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me

# Comma-separated. Ignored in dev.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres
DATABASE_NAME=cme_dev
DATABASE_USER=cme_app
DATABASE_PASSWORD=change-me
DATABASE_HOST=localhost
DATABASE_PORT=5432

# Email (Amazon SES over SMTP in prod; console backend in dev ignores these)
EMAIL_HOST=email-smtp.ca-central-1.amazonaws.com
EMAIL_PORT=587
EMAIL_HOST_USER=change-me
EMAIL_HOST_PASSWORD=change-me
DEFAULT_FROM_EMAIL=rounds@example.org

# Where raw Teams exports and issued PDFs are stored (outside the repo in prod)
UPLOAD_ROOT=./uploads
