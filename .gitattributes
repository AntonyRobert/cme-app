# Normalize line endings in the repo to LF; let Git pick the working-copy ending.
* text=auto

# Files that run on the Linux server must be LF even in a Windows checkout,
# regardless of anyone's core.autocrlf setting.
*.sh        text eol=lf
*.service   text eol=lf
*.timer     text eol=lf
Caddyfile   text eol=lf

# Binary: never touch.
*.pdf   binary
*.xlsx  binary
*.png   binary
*.jpg   binary

# Windows batch files need CRLF, whatever the checkout setting.
*.bat       text eol=crlf
