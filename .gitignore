# --- Secrets -----------------------------------------------------------------
# Real environment files never enter git. .env.example is the only exception.
.env
.env.*
!.env.example
*.env
env/
/etc/
*.pem
*.key
*.crt
*.p12
*.pfx
id_rsa*
id_ed25519*
credentials*.json
secrets*.json
.pgpass
pgpass.conf

# --- Personal data and artefacts of record -----------------------------------
# Raw Teams exports, generated certificates, and anything a user uploaded.
/uploads/
/media/
*.pdf
# Teams attendance exports arrive as .csv or .xlsx. Test fixtures must be
# synthetic and live under tests/fixtures/, which is explicitly re-included.
*.csv
*.xlsx
*.xls
!tests/fixtures/**/*.csv
!tests/fixtures/**/*.xlsx
!**/tests/fixtures/**/*.csv
!**/tests/fixtures/**/*.xlsx

# --- Databases and dumps -----------------------------------------------------
*.sqlite3
*.sqlite3-journal
db.sqlite3
*.dump
*.sql.gz
*.backup
/backups/
pgdata/

# --- Django ------------------------------------------------------------------
/staticfiles/
/static_collected/
*.log
logs/
local_settings.py

# --- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# --- Tests and tooling -------------------------------------------------------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.mypy_cache/
.ruff_cache/
.tox/
.hypothesis/

# --- Editors and OS ----------------------------------------------------------
.vscode/*
!.vscode/settings.json.example
.idea/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini

# --- Claude Code local state -------------------------------------------------
.claude/settings.local.json
