# /etc/cme/__ORG__.backup.env   mode 0600, owned by root, read ONLY by cme-backup@__ORG__.
# The restic repository for this tenant in the shared bucket, its own
# password and its own IAM user (scoped to this prefix). One bucket, no
# shared encryption key between institutions.
#
# RESTIC_PASSWORD MUST ALSO EXIST SOMEWHERE OTHER THAN THIS SERVER (a password
# manager, a sealed envelope): without it the backups are unrecoverable even
# with full AWS access. Encrypted means encrypted.
RESTIC_REPOSITORY=s3:s3.ca-central-1.amazonaws.com/mri3-cme-backups/__ORG__
RESTIC_PASSWORD=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
