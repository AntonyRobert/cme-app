# /etc/cme/__ORG__.env   mode 0600, owned by root, read by systemd and deploy.sh.
# Written by deploy/server-setup.sh. This is the only place production
# settings live; nothing here is in git.

DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_SECRET_KEY=__SECRET__

# Every hostname this instance answers to, comma-separated. Adding a CNAME is
# adding a name here and to /etc/caddy/sites/__ORG__.caddy.
DJANGO_ALLOWED_HOSTS=__HOSTNAME__

# Peer authentication: the database only. No user, password, host or port.
# The process connects as whichever OS user runs it (cme___ORG__ for gunicorn,
# cme___ORG___owner for migrate), and Postgres maps that to the role.
DATABASE_NAME=cme___ORG__

# Raw Teams exports and issued PDFs. Backups are their only copy.
UPLOAD_ROOT=/srv/cme/__ORG__/uploads
STATIC_ROOT=/srv/cme/__ORG__/staticfiles

# Email is a switch. "console" prints every email to the journal and sends
# nothing; magic links can be read with: journalctl -u cme@__ORG__
# When SES has verified the domain, set EMAIL_BACKEND=smtp and fill the rest.
EMAIL_BACKEND=console
# EMAIL_HOST=email-smtp.ca-central-1.amazonaws.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=rounds@__HOSTNAME__
