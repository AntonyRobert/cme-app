# One gunicorn per tenant. %i is the org: cme@mcgill selects /etc/cme/mcgill.env,
# /srv/cme/mcgill and /run/cme/mcgill/gunicorn.sock, and runs as the user cme_mcgill,
# which Postgres maps to the app role (no DDL, no UPDATE/DELETE on the audit log).
[Unit]
Description=CME rounds app (%i)
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=notify
User=cme_%i
Group=cme_%i
WorkingDirectory=/srv/cme/%i
EnvironmentFile=/etc/cme/%i.env
# systemd creates /run/cme/%i owned by cme_%i on every start (and /run/cme
# itself, root-owned, as the parent). /run is tmpfs, so nothing made by hand
# would survive a reboot; this does. 0750 with the tenant group: caddy is in
# that group and can reach the socket, and nobody else can.
RuntimeDirectory=cme/%i
RuntimeDirectoryMode=0750
# The socket itself is created 0660 cme_%i:cme_%i.
UMask=0007
ExecStart=/srv/cme/%i/.venv/bin/gunicorn config.wsgi:application \
    --bind unix:/run/cme/%i/gunicorn.sock \
    --workers 2 \
    --timeout 60 \
    --graceful-timeout 20 \
    --max-requests 1000 --max-requests-jitter 100 \
    --access-logfile - --error-logfile - \
    --forwarded-allow-ips='*'
ExecReload=/bin/kill -s HUP $MAINPID
KillMode=mixed
Restart=on-failure
RestartSec=3

# Hardening. The process may write its uploads and its socket, nothing else.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/cme/%i/uploads
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# The journal keeps stdout/stderr: journalctl -u cme@%i
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
